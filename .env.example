# Copy this file to .env (or export these directly) to configure VoxBuddy's
# backend. None of these are required to run the Phase 1 demo — everything
# defaults to mocked agents with zero config.

# --- Translation provider ---------------------------------------------
# "mock" (default) — no network calls, deterministic tagged output
# "anthropic" — real context-aware translation via Claude (requires the key below)
VOXBUDDY_TRANSLATION_PROVIDER=mock

# Required only if VOXBUDDY_TRANSLATION_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Not yet wired into the live pipeline (see docs/vendor_decision.md) --
# Present here for when agents/asr_assemblyai.py and agents/tts_elevenlabs.py
# get connected to session/manager.py.
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Authentication (email/phone + OTP, no passwords) -------------------
# "console" (default) — OTP is printed to the server console, zero config,
#   real end-to-end testing without any account. Set VOXBUDDY_AUTH_DEV_MODE=1
#   below to ALSO get the code back in the API response, so the frontend
#   can auto-fill it for you (see otp_providers.py).
# "brevo" — real email + SMS delivery via Brevo (one account, one API key,
#   covers both channels — see docs/vendor_decision.md and otp_providers.py)
VOXBUDDY_OTP_PROVIDER=console

# Convenience flag for local development ONLY — makes /api/auth/request-otp
# return the generated code in its JSON response. Never enable this in a
# real deployment; it defeats the entire point of an OTP.
VOXBUDDY_AUTH_DEV_MODE=1

# Required only if VOXBUDDY_OTP_PROVIDER=brevo
VOXBUDDY_BREVO_API_KEY=
VOXBUDDY_BREVO_SENDER_EMAIL=
VOXBUDDY_BREVO_SMS_SENDER=VoxBuddy

# Pepper mixed into OTP hashing so a leaked DB alone can't forge codes.
# Set a real random value in production; the fallback is fine for local dev.
VOXBUDDY_OTP_PEPPER=

# --- Session token storage ------------------------------------------------
# "sqlite" (default) — zero config, what tests and local dev use.
# "redis" — real Redis-backed auth tokens (fast lookup, native TTL,
#   shareable across multiple backend instances). Requires a reachable
#   Redis (default redis://localhost:6379/0, override with
#   VOXBUDDY_REDIS_URL). Does NOT affect live conversation state — see the
#   architectural note in backend/token_store.py for why that's a
#   deliberately different problem (sticky sessions, not Redis).
VOXBUDDY_SESSION_STORE=sqlite
VOXBUDDY_REDIS_URL=redis://localhost:6379/0
