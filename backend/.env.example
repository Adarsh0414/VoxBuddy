# Copy this file to .env in the backend/ folder and fill in real values.
# python-dotenv loads it automatically (see app.py) — no export commands needed.
# Nothing here is required to run the app; every provider defaults to a
# mock so the demo/dev flow always works with zero keys. Set a provider
# switch + its key to turn a piece from fake to real.

# ---- Translation (Claude or Gemini — pick one) ----------------------------
# Turns on real, context-aware translation instead of the "[en] ..." mock.
# Both are genuine alternatives, not a primary/fallback pair — use
# whichever vendor's pricing or quota you prefer, then set ONLY that
# provider's key below (the other can stay blank).
VOXBUDDY_TRANSLATION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# --- OR, if VOXBUDDY_TRANSLATION_PROVIDER=gemini instead: ---
GEMINI_API_KEY=

# ---- Speech-to-text (AssemblyAI) ------------------------------------------
# Turns on real transcription of your actual microphone audio, streamed
# through the new /ws/{session_id}/audio endpoint. Without this,
# VOXBUDDY_ASR_PROVIDER defaults to "mock", which proves the audio
# transport works but cannot read real speech.
VOXBUDDY_ASR_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=

# ---- Text-to-speech (ElevenLabs) ------------------------------------------
# Turns on real spoken audio for the translated text. A key alone is not
# enough — see VOICE ID setup in README/PROGRESS.md: agents/tts_elevenlabs.py
# ships with placeholder voice_ids that must be replaced with real ones
# from your ElevenLabs account before this will work.
VOXBUDDY_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=

# ---- Optional: OTP delivery -----------------------------------------------
# Without any of this, OTP codes print to the server console instead of
# being emailed/texted — fine for local testing, not for real users.
#
# Email and SMS are configured independently — you don't need the same
# vendor for both. Pick ONE option per channel:
#
#   Email: "brevo" (needs BREVO_API_KEY) or "smtp" (direct send via
#          Gmail/Outlook/any mail server — no third-party account beyond
#          the mailbox you already have; for Gmail use an App Password,
#          not your normal password)
#   SMS:   "brevo" (needs BREVO_API_KEY + a separate SMS add-on enabled
#          on your Brevo account — see app.brevo.com/transactional/sms)
#          or "fast2sms" (needs VOXBUDDY_FAST2SMS_API_KEY — India-focused,
#          free trial credit on signup, no separate add-on purchase)
VOXBUDDY_OTP_EMAIL_PROVIDER=smtp
VOXBUDDY_OTP_SMS_PROVIDER=fast2sms

# -- If using "brevo" for either channel above --
VOXBUDDY_BREVO_API_KEY=
VOXBUDDY_BREVO_SENDER_EMAIL=

# -- If using "smtp" for email above --
VOXBUDDY_SMTP_HOST=smtp.gmail.com
VOXBUDDY_SMTP_PORT=465
VOXBUDDY_SMTP_USERNAME=
VOXBUDDY_SMTP_PASSWORD=

# -- If using "fast2sms" for SMS above --
VOXBUDDY_FAST2SMS_API_KEY=

# Your real deployed backend URL (e.g. after Render step E) — only used to
# embed the real app logo image in OTP emails. Email clients can't load
# images from localhost, so without this the email still looks intentional,
# just with a text wordmark instead of the logo PNG.
VOXBUDDY_PUBLIC_URL=

# ---- Optional: Redis-backed auth sessions ---------------------------------
# Leave this commented out unless you're actually running a Redis server.
# Uncommenting VOXBUDDY_SESSION_STORE=redis with no real Redis reachable at
# REDIS_URL will make every login fail with a connection error — the
# default (this section left blank/commented) uses SQLite instead, which
# needs no setup and is what local dev and every test uses.
# VOXBUDDY_SESSION_STORE=redis
# REDIS_URL=redis://localhost:6379/0

# ---- Optional: Google Sign-In (alongside email/phone OTP, not replacing it)
# Get this from Google Cloud Console -> APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID -> Web application. Add both your
# local dev URL (http://localhost:8000) and your real deployed URL to
# "Authorized JavaScript origins" once you have one.
GOOGLE_CLIENT_ID=
